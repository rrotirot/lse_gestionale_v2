{
    "name": "rsi-api-proxy",
    "version": "1.0.0",
    "description": "Backend proxy per API RSI Star Citizen",
    "main": "dist/server.js",
    "bin": {
        "lse_member": "./lse_member.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node server.ts",
        "import-events": "node import-bot-events.js",
        "smoke": "node tests/smoke.test.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "docker:build": "docker compose build --no-cache",
        "docker:up": "docker compose up -d --build",
        "docker:down": "docker compose down -v",
        "docker:logs": "docker compose logs -f backend",
        "docker:test": "docker compose exec backend node tests/smoke-test-v2.js",
        "docker:clean": "docker compose down -v && docker image prune -f",
        "backup": "echo 'Backup MongoDB - usa MongoDB Atlas per backup automatici o mongodump per backup manuali'"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cheerio": "^1.0.0-rc.12",
        "cors": "^2.8.5",
        "csv-parser": "^3.2.0",
        "discord.js": "^14.14.1",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "multer": "^2.0.2",
        "node-fetch": "^2.7.0",
        "redis": "^4.6.13",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "winston": "^3.11.0"
    },
    "type": "commonjs",
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-rate-limit": "^5.1.3",
        "@types/express-validator": "^2.20.33",
        "@types/helmet": "^0.0.48",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.96",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/winston": "^2.4.4",
        "jest": "^29.7.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
