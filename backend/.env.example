# =========================================================================
# LSE GESTIONALE V2 - CONFIGURAZIONE VARIABILI D'AMBIENTE (BACKEND)
# =========================================================================
# Copia questo file in un nuovo file chiamato `.env` nella stessa cartella
# e compila i campi con i valori reali.

# --- Configurazione Server & Ambiente ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# --- Sicurezza & API Key ---
# Sostituisci dev-jwt-secret-key-for-development con una stringa casuale robusta in produzione
JWT_SECRET=dev-jwt-secret-key-for-development
API_KEY=dev-api-key-for-development

# --- Database & Cache ---
MONGODB_URI=mongodb://localhost:27017/lse-members
REDIS_URL=redis://localhost:6379

# --- Integrazione Discord Bot ---
# Incolla qui il Token segreto del bot (da Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN=MTIzNDU2Nzg5MDEyMzQ1Njc4LkdYeHh4eC54WFh4WFh4WFh4WFh4WFh4WFh4WFh4WFh4WFg=

# Incolla qui l'ID del tuo Server Discord (tasto destro sul server -> Copia ID server)
DISCORD_GUILD_ID=123456789012345678

# --- Opzioni di Sincronizzazione Membri Discord ---
# Tag di default assegnato ai membri importati da Discord (default: LSE-P)
DISCORD_SYNC_DEFAULT_TAG=LSE-P

# Origine del nome da importare: 'username' o 'displayName' (default: username)
DISCORD_SYNC_NAME_SOURCE=username

# (Opzionale) URL Webhook di Discord per l'invio dei log di sistema/sincronizzazione
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/abcdef
