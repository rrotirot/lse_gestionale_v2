// Endpoint per ripristinare un membro eliminato
app.post('/api/v1/deleted-members/:key/restore', checkMongoConnection, authenticateToken, async (req, res) => {
    console.log(`📥 Richiesta POST /api/v1/deleted-members/:key/restore ricevuta`);
    console.log(`📥 Params:`, req.params);
    console.log(`📥 Headers:`, req.headers);
    try {
        const { key } = req.params;
        console.log(`🔄 Tentativo di ripristino membro key=${key}`);

        // Trova il membro nel database eliminati
        const deletedMember = await DeletedMember.findOne({ key: parseInt(key) });

        if (!deletedMember) {
            console.error(`❌ Membro eliminato key=${key} non trovato`);
            return res.status(404).json({
                success: false,
                error: 'Membro eliminato non trovato'
            });
        }

        console.log(`📋 Membro eliminato trovato: ${deletedMember.name}, key=${deletedMember.key}`);

        // Verifica se il membro esiste già nel database principale
        const existingMember = await Member.findOne({ key: parseInt(key) });
        if (existingMember) {
            console.error(`❌ Membro key=${key} esiste già nel database principale`);
            return res.status(409).json({
                success: false,
                error: 'Un membro con questa key esiste già nel database principale'
            });
        }

        // Prepara i dati del membro da ripristinare (escludi i campi specifici dei membri eliminati)
        const memberData = deletedMember.toObject();
        delete memberData._id;
        delete memberData.deletedAt;
        delete memberData.deletedBy;
        delete memberData.originalCreatedAt;
        delete memberData.originalUpdatedAt;

        // Assicurati che i campi obbligatori siano presenti
        if (!memberData.key) {
            console.error(`❌ Key mancante per membro eliminato`);
            return res.status(400).json({
                success: false,
                error: 'Key del membro mancante'
            });
        }
        if (!memberData.name) {
            console.error(`❌ Nome mancante per membro key=${memberData.key}`);
            return res.status(400).json({
                success: false,
                error: 'Nome del membro mancante'
            });
        }

        // Assicurati che i campi opzionali abbiano valori di default
        memberData.index = memberData.index || '';
        memberData.tag = memberData.tag || 'LSE-P';
        memberData.id = memberData.id || '';
        memberData.date = memberData.date || '';
        memberData.idoneita = memberData.idoneita !== undefined ? memberData.idoneita : false;
        memberData.watchdog = memberData.watchdog !== undefined ? memberData.watchdog : false;
        memberData.promoted = memberData.promoted !== undefined ? memberData.promoted : false;
        memberData.affiliazioniOrg = memberData.affiliazioniOrg || '';
        memberData.note = memberData.note || '';

        // Gestisci orgValidation: se è un oggetto, assicurati che sia valido, altrimenti null
        if (memberData.orgValidation && typeof memberData.orgValidation === 'object') {
            // Assicurati che i campi booleani siano booleani
            if (memberData.orgValidation.isValid !== undefined) {
                memberData.orgValidation.isValid = Boolean(memberData.orgValidation.isValid);
            }
            if (memberData.orgValidation.hasOnlyOneOrg !== undefined) {
                memberData.orgValidation.hasOnlyOneOrg = Boolean(memberData.orgValidation.hasOnlyOneOrg);
            }
            if (memberData.orgValidation.hasMainName !== undefined) {
                memberData.orgValidation.hasMainName = Boolean(memberData.orgValidation.hasMainName);
            }
        } else {
            memberData.orgValidation = null;
        }

        // Ripristina le date originali se disponibili, altrimenti usa le date attuali
        const createdAt = deletedMember.originalCreatedAt || memberData.createdAt || new Date();
        const updatedAt = deletedMember.originalUpdatedAt || memberData.updatedAt || new Date();

        console.log(`💾 Preparazione dati ripristino:`, {
            key: memberData.key,
            name: memberData.name,
            hasOrgValidation: !!memberData.orgValidation,
            createdAt: createdAt,
            updatedAt: updatedAt
        });

        // Prepara l'oggetto di update
        const updateObj = {
            $set: {
                key: parseInt(key),
                index: memberData.index,
                tag: memberData.tag,
                name: memberData.name,
                id: memberData.id,
                date: memberData.date,
                idoneita: memberData.idoneita,
                watchdog: memberData.watchdog,
                promoted: memberData.promoted,
                affiliazioniOrg: memberData.affiliazioniOrg,
                note: memberData.note,
                updatedAt: updatedAt
            },
            $setOnInsert: {
                createdAt: createdAt
            }
        };

        // Aggiungi orgValidation solo se non è null
        if (memberData.orgValidation !== null) {
            updateObj.$set.orgValidation = memberData.orgValidation;
        } else {
            updateObj.$set.orgValidation = null;
        }

        // Salva il membro nel database principale
        console.log(`💾 Salvataggio membro nel database principale...`);
        const restoredMember = await Member.findOneAndUpdate(
            { key: parseInt(key) },
            updateObj,
            {
                new: true,
                upsert: true,
                runValidators: true,
                setDefaultsOnInsert: true
            }
        );

        if (!restoredMember) {
            console.error(`❌ Impossibile creare/aggiornare membro key=${key}`);
            return res.status(500).json({
                success: false,
                error: 'Impossibile ripristinare il membro nel database'
            });
        }

        console.log(`✅ Membro key=${key} (${deletedMember.name}) ripristinato nel database principale`);

        // Elimina il membro dal database eliminati
        await DeletedMember.findOneAndDelete({ key: parseInt(key) });
        console.log(`🗑️ Membro key=${key} (${deletedMember.name}) rimosso dal database eliminati`);

        return res.json({
            success: true,
            message: 'Membro ripristinato con successo',
            member: restoredMember
        });
    } catch (error) {
        console.error('❌ Errore nel ripristino membro:', error);
        console.error('Stack trace:', error.stack);
        return res.status(500).json({
            success: false,
            error: error.message || 'Errore interno del server',
            details: process.env.NODE_ENV === 'development' ? error.stack : undefined
        });
    }
});

// Endpoint per eliminare un membro (salva nel DB eliminati prima di rimuovere)
app.delete('/api/v1/members/:key', strictLimiter, checkMongoConnection, authenticateToken, async (req, res) => {
    try {
        const { key } = req.params;
        const { deletionReasons } = req.body || {};

        // Trova il membro da eliminare
        const member = await Member.findOne({ key: parseInt(key) });

        if (!member) {
            return res.status(404).json({
                success: false,
                error: 'Membro non trovato'
            });
        }

        // Recupera l'username dell'utente autenticato
        console.log(`🔍 Dati utente autenticato:`, {
            user: req.user,
            username: req.user?.username,
            userId: req.user?.userId
        });
        const deletedByUsername = req.user?.username || 'system';
        const deletedAt = new Date();

        console.log(`📝 Eliminazione membro key=${key} da parte di: ${deletedByUsername}`);
        
        // Assicurati che deletionReasons sia sempre un array
        const finalDeletionReasons = Array.isArray(deletionReasons) ? deletionReasons : [];
        
        if (finalDeletionReasons.length > 0) {
            console.log(`📋 Motivazioni eliminazione (${finalDeletionReasons.length}):`, finalDeletionReasons);
        } else {
            console.log(`⚠️ Nessuna motivazione specificata per l'eliminazione`);
        }

        // Salva il membro nel database dei membri eliminati
        const memberData = member.toObject();
        const deletedMemberData = {
            ...memberData,
            deletedAt: deletedAt,
            deletedBy: deletedByUsername,
            deletionReasons: finalDeletionReasons, // Sempre un array, anche se vuoto
            originalCreatedAt: memberData.createdAt,
            originalUpdatedAt: memberData.updatedAt
        };

        // Rimuovi _id per evitare conflitti
        delete deletedMemberData._id;

        const deletedMember = new DeletedMember(deletedMemberData);
        await deletedMember.save();
        console.log(`🗑️ Membro key=${key} (${member.name}) eliminato da ${deletedByUsername} il ${deletedAt.toISOString()}`);
        console.log(`   💾 Salvato con ${finalDeletionReasons.length} motivazioni di eliminazione`);

        // Elimina il membro dal database principale
        await Member.findOneAndDelete({ key: parseInt(key) });
        console.log(`✅ Membro key=${key} (${member.name}) eliminato dal database principale`);

        return res.json({
            success: true,
            message: 'Membro eliminato con successo e salvato nel database eliminati',
            deletedAt: deletedAt,
            deletedBy: deletedByUsername,
            deletionReasons: finalDeletionReasons // Sempre un array
        });
    } catch (error) {
        console.error('Errore nell\'eliminazione membro:', error);
        return res.status(500).json({
            success: false,
            error: error.message || 'Errore interno del server'
        });
    }
});

// Endpoint per ottenere le affiliazioni org di un utente RSI
// Usa la pagina pubblica delle organizzazioni invece dell'API
app.get('/api/v1/rsi/orgs/:handle', async (req, res) => {
    const { handle } = req.params;

    if (!handle) {
        return res.status(400).json({
            success: false,
            error: 'Handle utente richiesto'
        });
    }

    try {
        // Controlla cache
        const cacheKey = `rsi:orgs:${handle.toLowerCase()}`;
        const cachedResult = await cache.get(cacheKey);
        if (cachedResult) {
            logger.debug(`Cache HIT per ${cacheKey}`);
            return res.status(200).json({ ...cachedResult, _cached: true });
        }

        // Usa l'URL pubblico della pagina organizzazioni
        const orgPageUrl = `https://robertsspaceindustries.com/en/citizens/${encodeURIComponent(handle)}/organizations`;

        const response = await fetch(orgPageUrl, {
            method: 'GET',
            headers: {
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
            },
            timeout: 10000 // 10 secondi timeout
        });

        if (!response.ok) {
            // Se la risposta non è ok, restituisci comunque una validazione fallita
            const isNotFound = response.status === 404 || response.statusText.toLowerCase().includes('not found');
            const orgsString = isNotFound ? '404' : 'NO ORG MEMBERSHIP FOUND IN PUBLIC RECORDS';
            const issueMessage = isNotFound ? 'Errore nel recupero dati: Not Found' : `Errore nel recupero dati: ${response.statusText}`;

            return res.status(response.status).json({
                success: true,
                error: `Errore nel recupero pagina: ${response.statusText}`,
                user_handle: handle,
                orgs: [],
                orgs_string: orgsString,
                count: 0,
                validation: {
                    isValid: false,
                    hasOnlyOneOrg: false,
                    hasMainName: false,
                    mainOrgName: null,
                    issues: [issueMessage]
                }
            });
        }

        const html = await response.text();
        const $ = cheerio.load(html);

        const orgs = [];

        // Estrai il nome dell'organizzazione principale dalla pagina
        // Cerca pattern come "Main organization" seguito dal nome
        let mainOrgName = null;
        let mainOrgRank = null;

        // Cerca il nome dell'organizzazione principale
        // Pattern: cerca dopo "Main organization" o nel contenuto principale
        const mainOrgMatch = html.match(/Main organization[\s\S]*?<\/h[12]>[\s\S]*?<h[12][^>]*>([^<]+)<\/h[12]>/i);
        if (mainOrgMatch && mainOrgMatch[1]) {
            mainOrgName = mainOrgMatch[1].trim();
        }

        // Se non trovato, cerca direttamente nel testo HTML
        if (!mainOrgName) {
            // Cerca pattern come "Main organization" seguito da testo
            const textContent = $('body').text();
            const lines = textContent.split('\n').map(l => l.trim()).filter(l => l);

            // Cerca "Main organization" e prendi il nome successivo
            let foundMain = false;
            for (let i = 0; i < lines.length; i++) {
                if (lines[i].toLowerCase().includes('main organization')) {
                    // Cerca il nome nelle righe successive (di solito è il prossimo elemento non vuoto)
                    for (let j = i + 1; j < Math.min(i + 5, lines.length); j++) {
                        const line = lines[j];
                        // Ignora righe con solo numeri o etichette comuni
                        if (line &&
                            !line.match(/^\d+$/) &&
                            !line.toLowerCase().includes('members') &&
                            !line.toLowerCase().includes('overview') &&
                            line.length > 2 &&
                            line.length < 100) {
                            mainOrgName = line;
                            foundMain = true;
                            break;
                        }
                    }
                    if (foundMain) break;
                }
            }
        }

        // Estrai Organization rank
        // Cerca pattern come "Organization rank **Responsabile di Settore**"
        const rankMatch = html.match(/Organization rank[^:]*:\s*\*{0,2}([^<\n*]+)\*{0,2}/i) ||
            html.match(/rank[^:]*:\s*\*{0,2}([^<\n*]+)\*{0,2}/i) ||
            html.match(/Organization rank[^:]*:\s*([^<\n]+)/i) ||
            html.match(/rank[^:]*:\s*([^<\n]+)/i);
        if (rankMatch && rankMatch[1]) {
            mainOrgRank = rankMatch[1].trim().replace(/<[^>]+>/g, '').replace(/\*/g, '').trim();
        }

        // Estrai l'immagine dell'organizzazione principale
        let mainOrgImageUrl = null;
        if (mainOrgName) {
            // Cerca l'immagine dell'org nella pagina usando cheerio (più affidabile)
            // Cerca immagini nella sezione dell'organizzazione principale
            const orgSection = $('body').find('[class*="org"], [id*="org"], .organization, .org-item, h1, h2').filter((i, el) => {
                const text = $(el).text().toLowerCase();
                return text.includes('main organization') || text.includes(mainOrgName.toLowerCase());
            }).first().closest('div, section, article').first();

            // Cerca immagini nella sezione trovata o in tutto il body
            const searchArea = orgSection.length > 0 ? orgSection : $('body');

            // Cerca immagini con pattern comuni per org
            const orgImg = searchArea.find('img[src*="orgs"], img[src*="organization"], img[src*="/media/"]').first();

            if (orgImg.length > 0) {
                let src = orgImg.attr('src') || orgImg.attr('data-src');
                if (src) {
                    // Rimuovi query parameters e fragment
                    src = src.split('?')[0].split('#')[0];
                    mainOrgImageUrl = src.startsWith('http')
                        ? src
                        : `https://robertsspaceindustries.com${src}`;
                    console.log(`🖼️ Immagine org trovata nella pagina: ${mainOrgImageUrl}`);
                }
            }

            // Se non trovata, cerca con regex pattern
            if (!mainOrgImageUrl) {
                const imgPatterns = [
                    /<img[^>]*src=["']([^"']*\/media\/orgs[^"']*\.(jpg|jpeg|png|webp))["'][^>]*>/i,
                    /<img[^>]*src=["']([^"']*\/media\/[^"']*org[^"']*\.(jpg|jpeg|png|webp))["'][^>]*>/i,
                    /background-image:\s*url\(["']?([^"')]*\/media\/orgs[^"')]*)["']?\)/i
                ];

                for (const pattern of imgPatterns) {
                    const match = html.match(pattern);
                    if (match && match[1]) {
                        let src = match[1].split('?')[0].split('#')[0];
                        mainOrgImageUrl = src.startsWith('http')
                            ? src
                            : `https://robertsspaceindustries.com${src}`;
                        console.log(`🖼️ Immagine org trovata (regex): ${mainOrgImageUrl}`);
                        break;
                    }
                }
            }

            // Se ancora non trovata, prova a cercare nella pagina dell'organizzazione stessa
            if (!mainOrgImageUrl && mainOrgName) {
                try {
                    // Costruisci lo slug dell'org
                    const orgSlug = mainOrgName.toLowerCase()
                        .replace(/[^a-z0-9]+/g, '-')
                        .replace(/^-+|-+$/g, '');

                    // Prova a recuperare l'immagine dalla pagina dell'organizzazione
                    const orgPageUrl = `https://robertsspaceindustries.com/orgs/${orgSlug}`;
                    console.log(`🔍 Tentativo di recuperare immagine dalla pagina org: ${orgPageUrl}`);

                    try {
                        const orgPageResponse = await fetch(orgPageUrl, {
                            method: 'GET',
                            headers: {
                                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
                                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
                            }
                        });

                        if (orgPageResponse.ok) {
                            const orgPageHtml = await orgPageResponse.text();
                            const $orgPage = cheerio.load(orgPageHtml);

                            // Cerca l'immagine del logo nella pagina dell'org
                            const logoImg = $orgPage('img[src*="logo"], img[src*="banner"], img[src*="/media/orgs"]').first();
                            if (logoImg.length > 0) {
                                let src = logoImg.attr('src') || logoImg.attr('data-src');
                                if (src) {
                                    src = src.split('?')[0].split('#')[0];
                                    mainOrgImageUrl = src.startsWith('http')
                                        ? src
                                        : `https://robertsspaceindustries.com${src}`;
                                    console.log(`🖼️ Immagine org trovata nella pagina org: ${mainOrgImageUrl}`);
                                }
                            }

                            // Se non trovata, cerca con regex nella pagina org
                            if (!mainOrgImageUrl) {
                                const orgImgPatterns = [
                                    /<img[^>]*src=["']([^"']*\/media\/orgs[^"']*\.(jpg|jpeg|png|webp))["'][^>]*>/i,
                                    /<img[^>]*src=["']([^"']*logo[^"']*\.(jpg|jpeg|png|webp))["'][^>]*>/i,
                                    /background-image:\s*url\(["']?([^"')]*\/media\/orgs[^"')]*)["']?\)/i
                                ];

                                for (const pattern of orgImgPatterns) {
                                    const match = orgPageHtml.match(pattern);
                                    if (match && match[1]) {
                                        let src = match[1].split('?')[0].split('#')[0];
                                        mainOrgImageUrl = src.startsWith('http')
                                            ? src
                                            : `https://robertsspaceindustries.com${src}`;
                                        console.log(`🖼️ Immagine org trovata (regex pagina org): ${mainOrgImageUrl}`);
                                        break;
                                    }
                                }
                            }
                        }
                    } catch (orgPageError) {
                        console.warn(`⚠️ Errore nel recupero pagina org: ${orgPageError.message}`);
                    }

                    // Se ancora non trovata, usa URL costruito come fallback
                    if (!mainOrgImageUrl) {
                        // Per "Logistic Space Economy" -> "logistic-space-economy"
                        const possibleUrls = [
                            `https://robertsspaceindustries.com/media/orgs/${orgSlug}/logo.jpg`,
                            `https://robertsspaceindustries.com/media/orgs/${orgSlug}/logo.png`,
                            `https://robertsspaceindustries.com/media/orgs/${orgSlug}/banner.jpg`,
                            `https://robertsspaceindustries.com/media/orgs/${orgSlug}/banner.png`,
                            `https://robertsspaceindustries.com/media/orgs/${orgSlug}/org_logo.jpg`,
                            `https://robertsspaceindustries.com/media/orgs/${orgSlug}/org_logo.png`
                        ];

                        // Usa il primo URL come fallback
                        mainOrgImageUrl = possibleUrls[0];
                        console.log(`🖼️ Immagine org costruita (fallback): ${mainOrgImageUrl}`);
                    }
                } catch (error) {
                    console.warn('⚠️ Errore nella costruzione URL immagine org:', error);
                }
            }
        }

        // Se abbiamo trovato un'organizzazione principale, aggiungila
        if (mainOrgName) {
            orgs.push({
                name: mainOrgName,
                rank: mainOrgRank || null,
                imageUrl: mainOrgImageUrl || null
            });
        }

        // Cerca altre organizzazioni nella pagina (se presenti)
        // Cerca sezioni con "organization" nel testo o nelle classi
        $('[class*="org"], [id*="org"], .organization, .org-item').each((i, elem) => {
            const $elem = $(elem);
            const text = $elem.text().trim();

            // Se contiene "Main organization", salta (già processato)
            if (text.toLowerCase().includes('main organization')) {
                return;
            }

            // Cerca nomi di organizzazioni (pattern: testo con lunghezza ragionevole, non etichette)
            const orgNameMatch = text.match(/^([A-Z][A-Za-z0-9\s&]+)$/);
            if (orgNameMatch && orgNameMatch[1] && orgNameMatch[1].length > 3 && orgNameMatch[1].length < 100) {
                const name = orgNameMatch[1].trim();
                // Evita duplicati
                if (!orgs.some(o => o.name === name)) {
                    orgs.push({
                        name: name,
                        rank: null
                    });
                }
            }
        });

        // Verifica se la pagina contiene il messaggio "NO ORG MEMBERSHIP FOUND"
        const hasNoOrgMessage = html.toLowerCase().includes('no org membership found') ||
            html.toLowerCase().includes('no organization membership') ||
            html.toLowerCase().includes('no public records');

        // Se non ci sono organizzazioni trovate o il messaggio è presente, usa un messaggio specifico
        let orgsString = '';
        if (orgs.length > 0) {
            orgsString = orgs.map(org => org.name).join(', ');
        } else {
            // Se non ci sono org trovate, usa sempre il messaggio standard
            orgsString = 'NO ORG MEMBERSHIP FOUND IN PUBLIC RECORDS';
        }

        // Log per debug
        console.log(`🔍 Validazione per ${handle}:`, {
            orgsCount: orgs.length,
            hasNoOrgMessage: hasNoOrgMessage,
            orgsString: orgsString,
            mainOrgName: mainOrgName
        });

        // Verifica condizioni: solo una org e nome "Logistic Space Economy"
        const hasOnlyOneOrg = orgs.length === 1;
        const hasMainName = mainOrgName && mainOrgName.trim() === 'Logistic Space Economy';

        // Se non ci sono organizzazioni trovate, la validazione fallisce
        const isValid = orgs.length > 0 && hasOnlyOneOrg && hasMainName;

        // Costruisci i messaggi di errore
        const issues = [];
        if (!isValid) {
            // PRIORITÀ 1: Se non ci sono organizzazioni, questo è il problema principale
            if (orgs.length === 0 || hasNoOrgMessage) {
                issues.push('Nessuna organizzazione trovata nei registri pubblici');
            } else {
                // PRIORITÀ 2: Se ci sono org ma non solo una
                if (!hasOnlyOneOrg) {
                    issues.push(`Ha ${orgs.length} organizzazioni invece di 1`);
                }
                // PRIORITÀ 3: Se c'è una org ma il nome non è corretto
                if (!hasMainName) {
                    issues.push(`Main org nome è "${mainOrgName || 'non trovato'}" invece di "Logistic Space Economy"`);
                }
            }
        }

        // Assicurati che isValid sia sempre un booleano (non null/undefined)
        const validationResult = {
            isValid: Boolean(isValid), // Forza a booleano
            hasOnlyOneOrg: Boolean(hasOnlyOneOrg),
            hasMainName: Boolean(hasMainName),
            mainOrgName: mainOrgName || null,
            mainOrgImageUrl: mainOrgImageUrl || null,
            issues: issues || []
        };

        console.log(`📋 Validazione finale per ${handle}:`, validationResult);
        console.log(`🖼️ URL immagine org principale: ${mainOrgImageUrl || 'NON TROVATA'}`);

        const result = {
            success: true,
            user_handle: handle,
            orgs: orgs,
            orgs_string: orgsString,
            count: orgs.length,
            validation: validationResult
        };

        // Salva in cache per 24 ore (86400 secondi)
        await cache.set(`rsi:orgs:${handle.toLowerCase()}`, result, 86400);

        return res.json(result);

    } catch (error) {
        console.error('Errore nel recupero org RSI:', error);
        // Anche in caso di errore, restituisci una validazione fallita
        const errorMessage = error.message || 'Errore interno del server';
        const isNotFound = errorMessage.toLowerCase().includes('not found') ||
            errorMessage.toLowerCase().includes('404') ||
            error.code === 'ENOTFOUND' ||
            error.status === 404;
        const orgsString = isNotFound ? '404' : 'NO ORG MEMBERSHIP FOUND IN PUBLIC RECORDS';
        const issueMessage = isNotFound ? 'Errore nel recupero dati: Not Found' : `Errore nel recupero dati: ${errorMessage}`;

        return res.status(500).json({
            success: true,
            error: errorMessage,
            user_handle: req.params.handle,
            orgs: [],
            orgs_string: orgsString,
            count: 0,
            validation: {
                isValid: false,
                hasOnlyOneOrg: false,
                hasMainName: false,
                mainOrgName: null,
                issues: [issueMessage]
            }
        });
    }
});

// Endpoint health check
app.get('/api/v1/health', (req, res) => {
    res.json({
        status: 'ok',
        message: 'RSI API Proxy server is running',
        timestamp: new Date().toISOString()
    });
});

// ==================== ENDPOINT EVENTI ====================
// Compatibili per integrazione con bot Discord

/**
 * Helper function per inviare notifiche Discord via webhook
 * @param {Object} event - L'evento da notificare
 * @param {String} action - 'created', 'updated', 'deleted'
 */
async function notifyDiscordWebhook(event, action) {
    const webhookUrl = process.env.DISCORD_WEBHOOK_URL;
    if (!webhookUrl) {
        return; // Nessun webhook configurato, ignora silenziosamente
    }

    try {
        const actionMessages = {
            'created': '📅 Nuovo evento creato',
            'updated': '✏️ Evento modificato',
            'deleted': '🗑️ Evento eliminato'
        };

        const colors = {
            'created': 0x00ff00, // Verde
            'updated': 0x0099ff, // Blu
            'deleted': 0xff0000  // Rosso
        };

        const eventDate = new Date(event.date);
        const embed = {
            title: actionMessages[action] || 'Evento aggiornato',
            description: `**${event.title}**`,
            color: colors[action] || 0x0099ff,
            fields: [
                {
                    name: '📆 Data',
                    value: eventDate.toLocaleDateString('it-IT', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    }),
                    inline: true
                },
                {
                    name: '🏷️ Tipo',
                    value: event.type || 'evento',
                    inline: true
                }
            ],
            timestamp: new Date().toISOString()
        };

        if (event.startTime || event.endTime) {
            embed.fields.push({
                name: '⏰ Orario',
                value: `${event.startTime || ''}${event.startTime && event.endTime ? ' - ' : ''}${event.endTime || ''}`,
                inline: true
            });
        }

        if (event.location) {
            embed.fields.push({
                name: '📍 Location',
                value: event.location,
                inline: false
            });
        }

        if (event.description) {
            embed.fields.push({
                name: '📝 Descrizione',
                value: event.description.substring(0, 1024), // Limite Discord
                inline: false
            });
        }

        await fetch(webhookUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                embeds: [embed]
            }),
            timeout: 10000 // 10 secondi timeout
        });
    } catch (error) {
        console.error('❌ Errore nell\'invio webhook Discord:', error);
        // Non bloccare l'operazione se il webhook fallisce
    }
}

// GET /api/events - Ottieni tutti gli eventi (con filtri opzionali per bot Discord)
app.get('/api/v1/events', checkMongoConnection, async (req, res) => {
    try {
        const { 
            upcoming,      // Solo eventi futuri
            type,          // Filtra per tipo
            from,          // Data inizio (YYYY-MM-DD)
            to,            // Data fine (YYYY-MM-DD)
            limit          // Limita il numero di risultati
        } = req.query;

        let query = {};

        // Filtro per eventi futuri
        if (upcoming === 'true') {
            query.date = { $gte: new Date() };
        }

        // Filtro per tipo
        if (type) {
            query.type = type;
        }

        // Filtro per range di date
        if (from || to) {
            query.date = query.date || {};
            if (from) {
                query.date.$gte = new Date(from);
            }
            if (to) {
                query.date.$lte = new Date(to);
            }
        }

        let queryBuilder = Event.find(query).sort({ date: 1 });

        // Limita i risultati se richiesto
        if (limit) {
            queryBuilder = queryBuilder.limit(parseInt(limit));
        }

        const events = await queryBuilder.lean();
        
        res.json({
            success: true,
            count: events.length,
            events: events
        });
    } catch (error) {
        console.error('❌ Errore nel recupero eventi:', error);
        res.status(500).json({ 
            success: false,
            error: 'Errore nel recupero eventi' 
        });
    }
});

// GET /api/events/:id - Ottieni un singolo evento (utile per bot Discord)
app.get('/api/v1/events/:id', checkMongoConnection, async (req, res) => {
    try {
        const { id } = req.params;

        // Verifica che l'ID sia valido per MongoDB
        if (!id || !id.match(/^[0-9a-fA-F]{24}$/)) {
            return res.status(400).json({ 
                success: false,
                error: 'ID evento non valido' 
            });
        }

        const event = await Event.findById(id).lean();

        if (!event) {
            return res.status(404).json({ 
                success: false,
                error: 'Evento non trovato' 
            });
        }

        res.json({
            success: true,
            event: event
        });
    } catch (error) {
        console.error('❌ Errore nel recupero evento:', error);
        res.status(500).json({ 
            success: false,
            error: 'Errore nel recupero evento' 
        });
    }
});

// POST /api/events - Crea un nuovo evento (compatibile con bot Discord)
app.post('/api/v1/events', checkMongoConnection, async (req, res) => {
    try {
        const { title, description, date, startTime, endTime, location, type, createdBy, notifyDiscord } = req.body;

        // Validazione
        if (!title || !date) {
            return res.status(400).json({ 
                success: false,
                error: 'Titolo e data sono obbligatori' 
            });
        }

        // Crea nuovo evento
        // Gestisci la data evitando problemi di fuso orario
        // Se la data è in formato YYYY-MM-DD, crea la data usando i componenti
        let eventDate;
        if (typeof date === 'string' && date.match(/^\d{4}-\d{2}-\d{2}$/)) {
            // Formato YYYY-MM-DD: crea data locale a mezzanotte
            const [year, month, day] = date.split('-').map(Number);
            eventDate = new Date(year, month - 1, day);
        } else {
            eventDate = new Date(date);
        }

        const event = new Event({
            title,
            description: description || '',
            date: eventDate,
            startTime: startTime || '',
            endTime: endTime || '',
            location: location || '',
            type: type || 'evento',
            createdBy: createdBy || 'system'
        });

        const savedEvent = await event.save();

        // Notifica Discord se richiesto (default: true)
        if (notifyDiscord !== false) {
            await notifyDiscordWebhook(savedEvent.toObject(), 'created');
        }

        res.status(201).json({
            success: true,
            event: savedEvent
        });
    } catch (error) {
        console.error('❌ Errore nella creazione evento:', error);
        // Se è un errore di validazione Mongoose, fornisci dettagli
        if (error.name === 'ValidationError') {
            const errors = Object.values(error.errors).map(e => e.message).join(', ');
            return res.status(400).json({ 
                success: false,
                error: `Errore di validazione: ${errors}` 
            });
        }
        res.status(500).json({ 
            success: false,
            error: error.message || 'Errore nella creazione evento' 
        });
    }
});

// PUT /api/events/:id - Modifica un evento esistente (compatibile con bot Discord)
app.put('/api/v1/events/:id', checkMongoConnection, async (req, res) => {
    try {
        const { id } = req.params;
        const { title, description, date, startTime, endTime, location, type, notifyDiscord } = req.body;

        console.log(`📝 Tentativo di modifica evento con ID: ${id}`);

        // Validazione
        if (!title || !date) {
            return res.status(400).json({ 
                success: false,
                error: 'Titolo e data sono obbligatori' 
            });
        }

        // Verifica che l'ID sia valido per MongoDB
        if (!id || !id.match(/^[0-9a-fA-F]{24}$/)) {
            console.error(`❌ ID non valido: ${id}`);
            return res.status(400).json({ 
                success: false,
                error: 'ID evento non valido' 
            });
        }

        // Aggiorna evento
        // Gestisci la data evitando problemi di fuso orario
        let eventDate;
        if (typeof date === 'string' && date.match(/^\d{4}-\d{2}-\d{2}$/)) {
            // Formato YYYY-MM-DD: crea data locale a mezzanotte
            const [year, month, day] = date.split('-').map(Number);
            eventDate = new Date(year, month - 1, day);
        } else {
            eventDate = new Date(date);
        }

        const event = await Event.findByIdAndUpdate(
            id,
            {
                title,
                description: description || '',
                date: eventDate,
                startTime: startTime || '',
                endTime: endTime || '',
                location: location || '',
                type: type || 'evento',
                updatedAt: new Date()
            },
            { new: true, runValidators: true }
        );

        if (!event) {
            console.error(`❌ Evento con ID ${id} non trovato nel database`);
            return res.status(404).json({ 
                success: false,
                error: 'Evento non trovato' 
            });
        }

        // Notifica Discord se richiesto (default: true)
        if (notifyDiscord !== false) {
            await notifyDiscordWebhook(event.toObject(), 'updated');
        }

        console.log(`✅ Evento ${id} modificato con successo`);
        res.json({
            success: true,
            event: event
        });
    } catch (error) {
        console.error('❌ Errore nella modifica evento:', error);
        if (error.name === 'CastError') {
            return res.status(400).json({ 
                success: false,
                error: 'ID evento non valido' 
            });
        }
        res.status(500).json({ 
            success: false,
            error: 'Errore nella modifica evento' 
        });
    }
});

// DELETE /api/events/:id - Elimina un evento (compatibile con bot Discord)
app.delete('/api/v1/events/:id', checkMongoConnection, async (req, res) => {
    try {
        const { id } = req.params;
        const { notifyDiscord } = req.query; // Per DELETE, usa query params

        // Verifica che l'ID sia valido per MongoDB
        if (!id || !id.match(/^[0-9a-fA-F]{24}$/)) {
            return res.status(400).json({ 
                success: false,
                error: 'ID evento non valido' 
            });
        }

        // Recupera l'evento prima di eliminarlo per la notifica
        const eventToDelete = await Event.findById(id).lean();

        if (!eventToDelete) {
            return res.status(404).json({ 
                success: false,
                error: 'Evento non trovato' 
            });
        }

        // Elimina l'evento
        await Event.findByIdAndDelete(id);

        // Notifica Discord se richiesto (default: true)
        if (notifyDiscord !== 'false') {
            await notifyDiscordWebhook(eventToDelete, 'deleted');
        }

        res.json({ 
            success: true, 
            message: 'Evento eliminato con successo' 
        });
    } catch (error) {
        console.error('❌ Errore nell\'eliminazione evento:', error);
        res.status(500).json({ 
            success: false,
            error: 'Errore nell\'eliminazione evento' 
        });
    }
});

// ==================== API DI SINCRONIZZAZIONE PER BOT DISCORD ====================

// GET /api/sync/members - Sincronizza membri (bot -> web app e viceversa)
app.get('/api/v1/sync/members', checkMongoConnection, authenticateAPI, async (req, res) => {
    try {
        const { 
            since,      // Timestamp per sincronizzazione incrementale (ISO string o timestamp)
            tag,        // Filtra per tag specifico
            limit       // Limita risultati
        } = req.query;

        let query = {};

        // Filtro per sincronizzazione incrementale
        if (since) {
            const sinceDate = new Date(since);
            query.updatedAt = { $gte: sinceDate };
        }

        // Filtro per tag
        if (tag) {
            query.tag = tag;
        }

        let queryBuilder = Member.find(query).sort({ updatedAt: -1 });

        if (limit) {
            queryBuilder = queryBuilder.limit(parseInt(limit));
        }

        const members = await queryBuilder.lean();

        res.json({
            success: true,
            count: members.length,
            timestamp: new Date().toISOString(),
            members: members.map(m => ({
                key: m.key,
                name: m.name,
                id: m.id,
                tag: m.tag,
                index: m.index,
                date: m.date,
                idoneita: m.idoneita,
                watchdog: m.watchdog,
                promoted: m.promoted,
                affiliazioniOrg: m.affiliazioniOrg,
                orgValidation: m.orgValidation,
                note: m.note,
                createdAt: m.createdAt,
                updatedAt: m.updatedAt
            }))
        });
    } catch (error) {
        console.error('❌ Errore nella sincronizzazione membri:', error);
        res.status(500).json({
            success: false,
            error: 'Errore nella sincronizzazione membri'
        });
    }
});

// POST /api/sync/members - Sincronizza membri dal bot (bulk update)
app.post('/api/v1/sync/members', checkMongoConnection, authenticateAPI, async (req, res) => {
    try {
        const { members, syncMode = 'merge' } = req.body; // syncMode: 'merge' o 'replace'

        if (!Array.isArray(members) || members.length === 0) {
            return res.status(400).json({
                success: false,
                error: 'Array di membri richiesto'
            });
        }

        const operations = members.map(member => ({
            updateOne: {
                filter: { key: member.key },
                update: {
                    $set: {
                        ...member,
                        updatedAt: new Date()
                    }
                },
                upsert: true
            }
        }));

        const result = await Member.bulkWrite(operations);

        console.log(`🔄 Sincronizzazione membri completata: ${result.upsertedCount} inseriti, ${result.modifiedCount} aggiornati`);

        res.json({
            success: true,
            message: 'Sincronizzazione completata',
            inserted: result.upsertedCount,
            updated: result.modifiedCount,
            total: members.length
        });
    } catch (error) {
        console.error('❌ Errore nella sincronizzazione membri:', error);
        res.status(500).json({
            success: false,
            error: 'Errore nella sincronizzazione membri'
        });
    }
});

// GET /api/sync/events - Sincronizza eventi (bot -> web app e viceversa)
app.get('/api/v1/sync/events', checkMongoConnection, authenticateAPI, async (req, res) => {
    try {
        const { 
            since,      // Timestamp per sincronizzazione incrementale
            upcoming,   // Solo eventi futuri
            type,       // Filtra per tipo
            limit       // Limita risultati
        } = req.query;

        let query = {};

        if (since) {
            const sinceDate = new Date(since);
            query.updatedAt = { $gte: sinceDate };
        }

        if (upcoming === 'true') {
            query.date = { ...query.date, $gte: new Date() };
        }

        if (type) {
            query.type = type;
        }

        let queryBuilder = Event.find(query).sort({ date: 1 });

        if (limit) {
            queryBuilder = queryBuilder.limit(parseInt(limit));
        }

        const events = await queryBuilder.lean();

        res.json({
            success: true,
            count: events.length,
            timestamp: new Date().toISOString(),
            events: events
        });
    } catch (error) {
        console.error('❌ Errore nella sincronizzazione eventi:', error);
        res.status(500).json({
            success: false,
            error: 'Errore nella sincronizzazione eventi'
        });
    }
});

// POST /api/sync/events - Sincronizza eventi dal bot (bulk update)
app.post('/api/v1/sync/events', checkMongoConnection, authenticateAPI, async (req, res) => {
    try {
        const { events } = req.body;

        if (!Array.isArray(events) || events.length === 0) {
            return res.status(400).json({
                success: false,
                error: 'Array di eventi richiesto'
            });
        }

        const operations = events.map(event => ({
            updateOne: {
                filter: { _id: event._id || event.id },
                update: {
                    $set: {
                        title: event.title,
                        description: event.description || '',
                        date: new Date(event.date),
                        startTime: event.startTime || '',
                        endTime: event.endTime || '',
                        location: event.location || '',
                        type: event.type || 'evento',
                        updatedAt: new Date()
                    }
                },
                upsert: false // Non creare nuovi eventi, solo aggiorna esistenti
            }
        }));

        const result = await Event.bulkWrite(operations);

        console.log(`🔄 Sincronizzazione eventi completata: ${result.modifiedCount} aggiornati`);

        res.json({
            success: true,
            message: 'Sincronizzazione completata',
            updated: result.modifiedCount,
            total: events.length
        });
    } catch (error) {
        console.error('❌ Errore nella sincronizzazione eventi:', error);
        res.status(500).json({
            success: false,
            error: 'Errore nella sincronizzazione eventi'
        });
    }
});

// POST /api/import/bot-events - Importa eventi dal formato del bot Discord (da CSV/JSON)
// Nota: Non richiede autenticazione per permettere importazioni da script automatizzati
app.post('/api/v1/import/bot-events', checkMongoConnection, async (req, res) => {
    try {
        const { activities } = req.body; // Array di attività dal bot

        if (!Array.isArray(activities) || activities.length === 0) {
            return res.status(400).json({
                success: false,
                error: 'Array di attività richiesto'
            });
        }

        const imported = [];
        const errors = [];

        for (const activity of activities) {
            try {
                // Converti il formato del bot al formato del sistema
                let scheduledTime = activity.scheduled_start_time_iso || activity.datetime_input;
                if (!scheduledTime) {
                    errors.push({
                        activity: activity.id || activity.title,
                        error: 'Data non trovata'
                    });
                    continue;
                }

                // Se la data è nel formato "DD/MM/YYYY HH:mm", convertila in ISO
                if (typeof scheduledTime === 'string' && scheduledTime.match(/^\d{2}\/\d{2}\/\d{4} \d{2}:\d{2}$/)) {
                    // Formato: "14/11/2025 21:15"
                    const [datePart, timePart] = scheduledTime.split(' ');
                    const [day, month, year] = datePart.split('/').map(Number);
                    const [hours, minutes] = timePart.split(':').map(Number);
                    // Crea data in formato ISO (UTC)
                    scheduledTime = new Date(Date.UTC(year, month - 1, day, hours, minutes)).toISOString();
                }

                // Parsa la data ISO
                const eventDate = new Date(scheduledTime);
                if (isNaN(eventDate.getTime())) {
                    errors.push({
                        activity: activity.id || activity.title,
                        error: 'Data non valida'
                    });
                    continue;
                }

                // Estrai ora e minuti dalla data ISO
                const hours = eventDate.getHours().toString().padStart(2, '0');
                const minutes = eventDate.getMinutes().toString().padStart(2, '0');
                const startTime = `${hours}:${minutes}`;

                // Determina il tipo di evento dal config_json o dal titolo
                let eventType = 'evento';
                try {
                    if (activity.config_json) {
                        const config = typeof activity.config_json === 'string' 
                            ? JSON.parse(activity.config_json) 
                            : activity.config_json;
                        if (config.type === 'activity') {
                            eventType = 'attività';
                        }
                    }
                } catch (e) {
                    // Ignora errori di parsing del config
                }

                // Cerca se esiste già un evento con lo stesso titolo e data
                const existingEvent = await Event.findOne({
                    title: activity.title,
                    date: {
                        $gte: new Date(eventDate.getFullYear(), eventDate.getMonth(), eventDate.getDate()),
                        $lt: new Date(eventDate.getFullYear(), eventDate.getMonth(), eventDate.getDate() + 1)
                    }
                });

                if (existingEvent) {
                    // Aggiorna l'evento esistente
                    existingEvent.description = activity.description || existingEvent.description;
                    existingEvent.location = activity.location || existingEvent.location;
                    existingEvent.startTime = startTime;
                    existingEvent.type = eventType;
                    await existingEvent.save();
                    imported.push({ id: existingEvent._id, action: 'updated', title: activity.title });
                } else {
                    // Crea un nuovo evento
                    const newEvent = new Event({
                        title: activity.title,
                        description: activity.description || '',
                        date: eventDate,
                        startTime: startTime,
                        endTime: '',
                        location: activity.location || '',
                        type: eventType,
                        createdBy: activity.creator_id || 'discord-bot'
                    });
                    const savedEvent = await newEvent.save();
                    imported.push({ id: savedEvent._id, action: 'created', title: activity.title });
                }
            } catch (error) {
                console.error(`❌ Errore nell'importazione attività ${activity.id || activity.title}:`, error);
                errors.push({
                    activity: activity.id || activity.title,
                    error: error.message
                });
            }
        }

        console.log(`📥 Importazione eventi completata: ${imported.length} importati, ${errors.length} errori`);

        res.json({
            success: true,
            message: `Importazione completata: ${imported.length} eventi importati`,
            imported: imported.length,
            errors: errors.length,
            details: {
                imported,
                errors: errors.length > 0 ? errors : undefined
            }
        });
    } catch (error) {
        console.error('❌ Errore nell\'importazione eventi:', error);
        res.status(500).json({
            success: false,
            error: error.message || 'Errore nell\'importazione eventi'
        });
    }
});

// GET /api/discord/avatar/:userId - Ottiene l'avatar Discord di un utente
app.get('/api/v1/discord/avatar/:userId', checkMongoConnection, authenticateToken, async (req, res) => {
    try {
        const { userId } = req.params;
        const discordBotToken = process.env.DISCORD_BOT_TOKEN;

        if (!userId) {
            return res.status(400).json({
                success: false,
                error: 'User ID richiesto'
            });
        }

        if (!discordBotToken) {
            // Se non c'è il bot token, restituisci l'avatar di default
            const defaultAvatarIndex = parseInt(userId) % 6;
            return res.json({
                success: true,
                avatarUrl: `https://cdn.discordapp.com/embed/avatars/${defaultAvatarIndex}.png`,
                isDefault: true
            });
        }

        // Chiama l'API Discord usando il bot token (sul server non ci sono problemi di CORS)
        const response = await fetch(`https://discord.com/api/v10/users/${userId}`, {
            headers: {
                'Authorization': `Bot ${discordBotToken}`,
            },
            timeout: 10000 // 10 secondi timeout
        });

        if (!response.ok) {
            // Se l'utente non esiste o errore, restituisci l'avatar di default
            const defaultAvatarIndex = parseInt(userId) % 6;
            return res.json({
                success: true,
                avatarUrl: `https://cdn.discordapp.com/embed/avatars/${defaultAvatarIndex}.png`,
                isDefault: true
            });
        }

        const userData = await response.json();
        
        if (userData.avatar) {
            const avatarHash = userData.avatar;
            const isAnimated = avatarHash.startsWith('a_');
            const extension = isAnimated ? 'gif' : 'png';
            const avatarUrl = `https://cdn.discordapp.com/avatars/${userId}/${avatarHash}.${extension}?size=128`;
            
            return res.json({
                success: true,
                avatarUrl: avatarUrl,
                isDefault: false
            });
        }

        // Se non ha avatar personalizzato, usa l'avatar di default
        const defaultAvatarIndex = (parseInt(userId) >> 22) % 6;
        return res.json({
            success: true,
            avatarUrl: `https://cdn.discordapp.com/embed/avatars/${defaultAvatarIndex}.png`,
            isDefault: true
        });
    } catch (error) {
        console.error('❌ Errore nel recupero avatar Discord:', error);
        // In caso di errore, restituisci l'avatar di default
        const defaultAvatarIndex = parseInt(req.params.userId || '0') % 6;
        return res.json({
            success: true,
            avatarUrl: `https://cdn.discordapp.com/embed/avatars/${defaultAvatarIndex}.png`,
            isDefault: true
        });
    }
});

