    console.log(`\n🔄 API di Sincronizzazione per Bot Discord:`);
    console.log(`   GET    /api/sync/test - Test autenticazione`);
    console.log(`   GET    /api/sync/members - Ottieni membri (filtri: since, tag, limit)`);
    console.log(`   POST   /api/sync/members - Sincronizza membri (bulk)`);
    console.log(`   GET    /api/sync/events - Ottieni eventi (filtri: since, upcoming, type, limit)`);
    console.log(`   POST   /api/sync/events - Sincronizza eventi (bulk)`);
    console.log(`   GET    /api/sync/status - Stato sincronizzazione`);
    console.log(`\n🔐 Autenticazione API:`);
    console.log(`   Header: X-API-Key: <api-key> oppure Authorization: ApiKey <api-key>`);
    console.log(`   Oppure: Authorization: Bearer <jwt-token> (per utenti web)`);
    if (process.env.DISCORD_WEBHOOK_URL) {
        console.log(`   ✅ Webhook Discord configurato`);
    } else {
        console.log(`   ⚠️  Webhook Discord non configurato (DISCORD_WEBHOOK_URL)`);
    }
    if (process.env.DISCORD_BOT_TOKEN) {
        console.log(`   ✅ Discord Bot Token configurato (per avatar)`);
    } else {
        console.log(`   ⚠️  Discord Bot Token non configurato (DISCORD_BOT_TOKEN)`);
    }
    if (API_KEY) {
        console.log(`   ✅ API Key configurata`);
    } else {
        console.log(`   ⚠️  API Key non configurata (API_KEY o DISCORD_BOT_API_KEY)`);
    }
});

