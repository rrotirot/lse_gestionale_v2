# =========================================================================
# LOCAL DEVELOPMENT ENVIRONMENT - Backend Configuration
# =========================================================================
# Questo file è usato per lo sviluppo locale con esclusione delle regole di produzione
# Copia questo file a `.env` quando sviluppi localmente

# --- Configurazione Server & Ambiente ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# --- Sicurezza & API Key (DISABLE STRICT MODE IN DEV) ---
# ⚠️ Questi sono secret di SVILUPPO - NON usare in produzione!
JWT_SECRET=dev-jwt-secret-key-for-development
API_KEY=dev-api-key-for-development

# Disabilita rate limiting in sviluppo (meno frustrante durante il testing)
RATE_LIMIT_DISABLED=true

# Disabilita strict CORS checking in dev
CORS_STRICT=false

# --- Database & Cache (LOCALHOST) ---
# MongoDB locale (assicurati di avere MongoDB in esecuzione)
# Opzione 1: MongoDB locale
MONGODB_URI=mongodb://localhost:27017/lse-members

# Opzione 2: MongoDB Atlas (commentato, decommentare se preferisci)
# MONGODB_URI=mongodb+srv://roccorotiroti_db_user:ZGGC4eoseYnvXaCz@cluster0.lmzr2w8.mongodb.net/?appName=Cluster0

# Redis locale (usato per cache)
REDIS_URL=redis://localhost:6379

# --- Logging & Debug ---
# Abilita verbose logging in sviluppo
DEBUG=lse:*
LOG_LEVEL=debug

# --- Integrazione Discord Bot (OPZIONALE in DEV) ---
# Puoi lasciare questi vuoti se non testti Discord in locale
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Opzioni di Sincronizzazione Membri Discord (OPZIONALE) ---
DISCORD_SYNC_DEFAULT_TAG=LSE-P
DISCORD_SYNC_NAME_SOURCE=displayName

# --- Features Flag per Development ---
# Disabilita helmet (security middleware) in strict mode per development
HELMET_DISABLED=false

# Disabilita validazione input rigorosa
STRICT_VALIDATION=false

# Abilita API debug endpoints
ENABLE_DEBUG_ENDPOINTS=true

# --- Proxy Configuration (opzionale) ---
# Se devi usare un proxy per accedere a risorse esterne
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
